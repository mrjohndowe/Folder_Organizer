<Window x:Class="FolderOrganizer.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Title="MJD Organization History"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Organization Runs"
                   FontSize="22"
                   FontWeight="Bold"
				   Background="{DynamicResource ControlBackgroundBrush}"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  x:Name="RunsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
				  Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  SelectionChanged="RunsDataGrid_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Run"
                    Binding="{Binding Id}"
                    Width="70"/>

                <DataGridTextColumn
                    Header="Folder"
                    Binding="{Binding RootFolder}"
                    Width="3*"/>

                <DataGridTextColumn
                    Header="Started"
                    Binding="{Binding StartedAt}"
                    Width="170"/>

                <DataGridTextColumn
                    Header="Completed"
                    Binding="{Binding CompletedAt}"
                    Width="170"/>

                <DataGridTextColumn
                    Header="Planned"
                    Binding="{Binding PlannedMoves}"
                    Width="85"/>

                <DataGridTextColumn
                    Header="Success"
                    Binding="{Binding SuccessfulMoves}"
                    Width="85"/>

                <DataGridTextColumn
                    Header="Failed"
                    Binding="{Binding FailedMoves}"
                    Width="75"/>

            </DataGrid.Columns>

        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Files"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,16,0,8"/>

        <DataGrid Grid.Row="3"
                  x:Name="MovesDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Type"
                    Binding="{Binding FileType}"
                    Width="90"/>

                <DataGridTextColumn
                    Header="Status"
                    Binding="{Binding Status}"
                    Width="90"/>

                <DataGridTextColumn
                    Header="Source"
                    Binding="{Binding SourcePath}"
                    Width="3*"/>

                <DataGridTextColumn
                    Header="Requested Destination"
                    Binding="{Binding DestinationPath}"
                    Width="3*"/>

                <DataGridTextColumn
                    Header="Final Destination"
                    Binding="{Binding FinalDestinationPath}"
                    Width="3*"/>

                <DataGridTextColumn
                    Header="Error"
                    Binding="{Binding ErrorMessage}"
                    Width="2*"/>

            </DataGrid.Columns>

        </DataGrid>

        <Grid Grid.Row="4"
              Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="RefreshButton_Click"/>

            <Button Grid.Column="2"
                    Content="Close"
                    Width="100"
                    Height="34"
                    Click="CloseButton_Click"/>

        </Grid>

    </Grid>
</Window>
