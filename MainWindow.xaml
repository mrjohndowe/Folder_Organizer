<Window x:Class="FolderOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:models="clr-namespace:FolderOrganizer.Models"
		Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Title="MJD Folder Organizer"
	    xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Width="1200"
        Height="720"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen">


    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

			<StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">

				<TextBlock
					Text="Folder Organizer"
					FontSize="26"
					FontWeight="SemiBold" />

				<TextBlock
					x:Name="TitleBarVersionText"
					Text=""
					Foreground="#7A808A"
					FontSize="11"
					Margin="8,1,0,0"
					VerticalAlignment="Center" />

			</StackPanel>

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal">

				<Button Content="⚙ Settings"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Click="SettingsButton_Click"/>

				<Button Content="Check Updates"
                        Padding="14,8"
                        Click="CheckUpdatesButton_Click"/>

			</StackPanel>



        </Grid>

        <!-- Folder selection -->
        <Grid Grid.Row="1"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Folder:"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="FolderPathTextBox"
                     Grid.Column="1"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"/>

            <Button Grid.Column="2"
                    Content="Browse"
                    Width="90"
                    Margin="0,0,8,0"
                    Click="BrowseButton_Click"/>

            <Button Grid.Column="3"
                    x:Name="ScanButton"
                    Content="Scan"
                    Width="90"
                    Click="ScanButton_Click"/>
        </Grid>

        <!-- Options -->
        <Border Grid.Row="2"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,12">

            <StackPanel>

                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="IncludeSubfoldersCheckBox"
                              Content="Include Subfolders"
                              IsChecked="True"
                              Margin="0,0,24,0"/>

                    <CheckBox x:Name="PreviewCheckBox"
                              Content="Preview Changes Before Applying"
                              IsChecked="True"
                              IsEnabled="False"
                              Margin="0,0,24,0"/>

                    <CheckBox x:Name="NeverDeleteCheckBox"
                              Content="Never Delete Anything"
                              IsChecked="True"
                              IsEnabled="False"/>
                </StackPanel>

                <!-- Special Rules Section -->
                <Border BorderBrush="#EEE"
                        BorderThickness="0,1,0,0"
                        Padding="0,12,0,0"
                        Margin="0,12,0,0">

                    <StackPanel>
                        <TextBlock Text="Special Rules"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="OrganizeByYearCheckBox"
                                      Content="Organize by Year"
                                      IsChecked="False"
                                      Margin="0,0,24,0"
                                      Checked="OrganizeByYearCheckBox_Checked"
                                      Unchecked="OrganizeByYearCheckBox_Unchecked"/>

                            <CheckBox x:Name="OrganizeByMonthCheckBox"
                                      Content="Organize by Month"
                                      IsChecked="False"
                                      IsEnabled="False"
                                      Margin="0,0,24,0"
                                      Checked="OrganizeByMonthCheckBox_Checked"
                                      Unchecked="OrganizeByMonthCheckBox_Unchecked"/>

                            <CheckBox x:Name="UseCreationDateCheckBox"
                                      Content="Use Creation Date"
                                      IsChecked="True"
                                      Margin="0,0,24,0"
                                      Checked="UseCreationDateCheckBox_Checked"
                                      Unchecked="UseCreationDateCheckBox_Unchecked"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <TextBlock Text="Apply to extensions:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <TextBox x:Name="SpecialRuleExtensionsTextBox"
                                     Width="200"
                                     Height="24"
                                     VerticalContentAlignment="Center"
                                     Text=""
                                     ToolTip=""/>

                            <Button Content="Apply Special Rule"
                                    Width="130"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Click="ApplySpecialRuleButton_Click"/>

							<TextBlock Text="Leave empty to apply to all files. Use commas, semicolons, or spaces to separate extensions (e.g., .jpg, .png, .gif)"
									   Margin="15,15,0,0"
									   Opacity="0.65"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Collapsible scan preview -->
        <Border Grid.Row="3"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="32,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mark" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="Use" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="File / Folder" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="4" Text="Action" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="5" Text="Destination / Details" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Grid>

            <TreeView Grid.Row="1"
                      x:Name="PreviewTreeView"
                      ItemsSource="{Binding ScanTree}"
                      Background="Transparent"
                      Foreground="{DynamicResource TextBrush}">
                <TreeView.Resources>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>

                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    </Style>

                    <HierarchicalDataTemplate DataType="{x:Type models:ScanTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsMarked}"
                                      IsEnabled="{Binding HasOperation}"
                                      ToolTip="Mark this item for Ignore, Remove Ignore, or folder actions."/>

                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding Selected}"
                                      IsEnabled="{Binding CanApply}"
                                      Click="PreviewUseCheckBox_Click"
                                      ToolTip="Include this proposed move when applying changes."/>

                            <svgc:SvgViewbox Grid.Column="2"
                                              Source="{Binding IconPath}"
                                              Width="20"
                                              Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Action}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="5"
                                       Text="{Binding Summary}"
                                       VerticalAlignment="Center"
                                       Opacity="0.72"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Reason}"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
            </Grid>
        </Border>

        <!-- Bottom controls -->
        <Grid Grid.Row="4"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusTextBlock"
					Background="{DynamicResource ControlBackgroundBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    VerticalAlignment="Center"
                    Text="Ready."/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

				<Button Content="Ignore Marked"
                    Width="120"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="IgnoreSelectedButton_Click"/>

				<Button Content="Remove Ignore"
                    Width="110"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="RemoveIgnoreButton_Click"/>

                <Button Content="Mark Folder for Removal"
                    Width="170"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="MarkFoldersForRemovalButton_Click"/>

                <Button Content="Move Folder &amp; Contents"
                    Width="180"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="MoveFoldersButton_Click"/>

				<Button Content="History"
		             Width="100"
		             Height="36"
		             Margin="0,0,8,0"
		             Click="HistoryButton_Click"/>

				<Button x:Name="ApplyButton"
                    Content="Apply Changes"
                    Width="130"
                    Height="36"
                    IsEnabled="False"
                    Click="ApplyButton_Click"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>
