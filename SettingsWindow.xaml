<Window x:Class="FolderOrganizer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        MinHeight="450"
        MinWidth="700"
        Title="MJD Folder Organizer Settings"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Header -->
    <StackPanel Margin="0,0,0,16" Grid.Row="0">
      <TextBlock FontSize="26" FontWeight="Bold" Text="Settings" />
      <TextBlock Margin="0,4,0,0"
                 Opacity="0.65"
                 Text="Custom rules are checked before built-in organization rules." />
    </StackPanel>
    <!-- Custom Rules Header -->
    <Grid Margin="0,0,0,8" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center"
                 FontSize="18"
                 FontWeight="SemiBold"
                 Text="Custom Folder Rules" />
      <StackPanel Orientation="Horizontal" Grid.Column="1">
        <Button x:Name="DeleteRuleButton"
                Content="Delete Selected"
                Width="125"
                Height="34"
                Margin="0,0,8,0"
                Click="DeleteRuleButton_Click" />
        <Button x:Name="AddRuleButton"
                Content="+ Add Custom Rule"
                Width="145"
                Height="34"
                Click="AddRuleButton_Click" />
      </StackPanel>
    </Grid>
    <!-- Rules -->
    <DataGrid x:Name="RulesDataGrid"
              AllowDrop="True"
              AutoGenerateColumns="False"
              Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CellEditEnding="RulesDataGrid_CellEditEnding"
              Drop="RulesDataGrid_Drop"
              Foreground="{DynamicResource TextBrush}"
              GridLinesVisibility="Horizontal"
              IsReadOnly="False"
              PreviewMouseLeftButtonDown="RulesDataGrid_PreviewMouseLeftButtonDown"
              PreviewMouseMove="RulesDataGrid_PreviewMouseMove"
              SelectionMode="Single"
              Grid.Row="2">
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="36" Header="" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="16"
                         Text="☰"
                         ToolTip="Drag to reorder" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn x:Name="PriorityColumn"
                                Width="80"
                                Header="Priority">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{Binding Priority}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox HorizontalContentAlignment="Center"
                       LostFocus="PriorityTextBox_LostFocus"
                       Text="{Binding Priority, Mode=OneWay}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Width="75" Header="Enabled">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Checked="EnabledCheckBox_Changed"
                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Unchecked="EnabledCheckBox_Changed" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Width="2*"
                            Binding="{Binding FolderName,                                       Mode=TwoWay,                                       UpdateSourceTrigger=PropertyChanged}"
                            Header="Folder" />
        <DataGridTextColumn Width="3*"
                            Binding="{Binding Extensions,                                       Mode=TwoWay,                                       UpdateSourceTrigger=PropertyChanged}"
                            Header="Extensions" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Margin="0,16,0,8"
               FontSize="18"
               FontWeight="SemiBold"
               Text="Built-in Rules" />
    <DataGrid x:Name="BuiltInRulesDataGrid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              GridLinesVisibility="Horizontal"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Width="45"
                            Binding="{Binding Icon}"
                            Header="" />
        <DataGridTextColumn Width="2*"
                            Binding="{Binding Folder}"
                            Header="Folder" />
        <DataGridTextColumn Width="4*"
                            Binding="{Binding Extensions}"
                            Header="Extensions" />
      </DataGrid.Columns>
    </DataGrid>
    <!-- Bottom -->
    <Grid Margin="0,12,0,0" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusTextBlock"
                 VerticalAlignment="Center"
                 Text="Ready." />
      <Button Content="Close"
              Width="100"
              Height="34"
              Click="CloseButton_Click"
              Grid.Column="1" />
      <CheckBox x:Name="DarkModeCheckBox"
                Content="Dark Mode"
                Margin="650,8,0,8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Checked="DarkModeCheckBox_Changed"
                Unchecked="DarkModeCheckBox_Changed"
                Grid.Column="0"
                Grid.Row="0" />
    </Grid>
  </Grid>
</Window>