<Window
    x:Class="FolderOrganizer.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MJD Folder Organizer Settings"
    Width="900"
    Height="600"
    MinWidth="700"
    MinHeight="450"
	xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">

	<Grid Margin="16">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/> <!-- 0 Header -->
			<RowDefinition Height="Auto"/> <!-- 1 Custom Rules header + buttons -->
			<RowDefinition Height="2*"/> <!-- 2 Custom Rules DataGrid -->
			<RowDefinition Height="Auto"/> <!-- 3 Built-in Rules heading -->
			<RowDefinition Height="*"/> <!-- 4 Built-in Rules DataGrid -->
			<RowDefinition Height="Auto"/> <!-- 5 Status + Dark Mode + Close -->
		</Grid.RowDefinitions>

		<!-- Header -->
		<StackPanel
            Grid.Row="0"
            Margin="0,0,0,16">

			<TextBlock
                Text="Settings"
                FontSize="26"
                FontWeight="Bold"/>

			<TextBlock
                Text="Custom rules are checked before built-in organization rules."
                Margin="0,4,0,0"
                Foreground="{DynamicResource SecondaryTextBrush}"/>

		</StackPanel>

		<!-- Custom Rules Header -->
		<Grid
            Grid.Row="1"
            Margin="0,0,0,8">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock
                Text="Custom Folder Rules"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"/>

			<StackPanel
                Grid.Column="1"
                Orientation="Horizontal">

				<Button
                    x:Name="DeleteRuleButton"
                    Content="Delete Selected"
                    Width="125"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="DeleteRuleButton_Click"/>

				<Button
                    x:Name="AddRuleButton"
                    Content="+ Add Custom Rule"
                    Width="145"
                    Height="34"
                    Click="AddRuleButton_Click"/>

			</StackPanel>

		</Grid>

		<!-- Custom Rules Grid -->
		<DataGrid
            x:Name="RulesDataGrid"
            Grid.Row="2"
            AllowDrop="True"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CellEditEnding="RulesDataGrid_CellEditEnding"
            Drop="RulesDataGrid_Drop"
            GridLinesVisibility="Horizontal"
            IsReadOnly="False"
            PreviewMouseLeftButtonDown="RulesDataGrid_PreviewMouseLeftButtonDown"
            PreviewMouseMove="RulesDataGrid_PreviewMouseMove"
            SelectionMode="Single"
            Background="{DynamicResource PanelBackgroundBrush}"
            Foreground="{DynamicResource TextBrush}"
            BorderBrush="{DynamicResource BorderBrush}">

			<DataGrid.Columns>

			

				<!-- Drag Handle -->
				<DataGridTemplateColumn
                    Width="36"
                    Header=""
                    IsReadOnly="True">

					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<TextBlock
                                Text="☰"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip="Drag to reorder"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>

				<!-- Priority -->
				<DataGridTemplateColumn
                    x:Name="PriorityColumn"
                    Width="80"
                    Header="Priority">

					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<TextBlock
                                Text="{Binding Priority}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

					<DataGridTemplateColumn.CellEditingTemplate>
						<DataTemplate>

							<TextBox
                                Text="{Binding Priority, Mode=OneWay}"
                                HorizontalContentAlignment="Center"
                                LostFocus="PriorityTextBox_LostFocus"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellEditingTemplate>

				</DataGridTemplateColumn>

				<!-- Enabled -->
				<DataGridTemplateColumn
                    Width="75"
                    Header="Enabled">

					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<CheckBox
                                IsChecked="{Binding IsEnabled,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Checked="EnabledCheckBox_Changed"
                                Unchecked="EnabledCheckBox_Changed"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>

				<DataGridTemplateColumn
                        Header=""
                        Width="48"
                        IsReadOnly="True">

					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>

							<svgc:SvgViewbox
                                Source="pack://application:,,,/Assets/root_folder.svg"
                                Width="22"
                                Height="22"
                                Stretch="Uniform"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>

				</DataGridTemplateColumn>

				<DataGridTextColumn
                    Header="Folder"
                    Width="2*"
                    Binding="{Binding FolderName,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

				<DataGridTextColumn
                    Header="Extensions"
                    Width="3*"
                    Binding="{Binding Extensions,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"/>

			</DataGrid.Columns>

		</DataGrid>

		<!-- Built-in Rules Heading -->
		<TextBlock
            Grid.Row="3"
            Text="Built-in Rules"
            Margin="0,16,0,8"
            FontSize="18"
            FontWeight="SemiBold"/>

		<!-- Built-in Rules Grid -->
		<DataGrid
            x:Name="BuiltInRulesDataGrid"
            Grid.Row="4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            GridLinesVisibility="Horizontal"
            Background="{DynamicResource PanelBackgroundBrush}"
            Foreground="{DynamicResource TextBrush}"
            BorderBrush="{DynamicResource BorderBrush}">

			<DataGrid.Columns>

				<DataGridTemplateColumn
                        Header=""
                        Width="48"
                        IsReadOnly="True">

				    <DataGridTemplateColumn.CellTemplate>
					    <DataTemplate>

							<svgc:SvgViewbox
							    Source="{Binding IconPath}"
							    Width="22"
							    Height="22"
							    Stretch="Uniform"
							    HorizontalAlignment="Center"
							    VerticalAlignment="Center"/>

					    </DataTemplate>
				    </DataGridTemplateColumn.CellTemplate>

			    </DataGridTemplateColumn>

				<DataGridTextColumn
                    Header="Folder"
                    Width="2*"
                    Binding="{Binding Folder}"/>

				<DataGridTextColumn
                    Header="Extensions"
                    Width="4*"
                    Binding="{Binding Extensions}"/>

			</DataGrid.Columns>

		</DataGrid>

		<!-- Footer -->
		<Grid
            Grid.Row="5"
            Margin="0,12,0,0">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock
                x:Name="StatusTextBlock"
                Grid.Column="0"
                Text="Ready."
                VerticalAlignment="Center"
                Foreground="{DynamicResource SecondaryTextBrush}"/>

			<CheckBox
                x:Name="DarkModeCheckBox"
                Grid.Column="1"
                Content="Dark Mode"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Checked="DarkModeCheckBox_Changed"
                Unchecked="DarkModeCheckBox_Changed"/>

			<Button
                Grid.Column="2"
                Content="Close"
                Width="100"
                Height="34"
                Click="CloseButton_Click"/>

		</Grid>

	</Grid>

</Window>