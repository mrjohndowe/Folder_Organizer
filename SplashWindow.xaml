<Window x:Class="FolderOrganizer.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Width="1240"
        Height="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False">

	<Window.Resources>

		<!-- Moving file animation -->
		<Storyboard
			x:Key="FileTransferStoryboard"
			RepeatBehavior="Forever">

			<!-- FILE 1 -->
			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File1Transform"
				Storyboard.TargetProperty="X"
				BeginTime="0:0:0">

				<SplineDoubleKeyFrame
					KeyTime="0:0:0"
					Value="0"/>

				<SplineDoubleKeyFrame
					KeyTime="0:0:0.75"
					Value="155"/>

				<SplineDoubleKeyFrame
					KeyTime="0:0:1.5"
					Value="315"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File1Transform"
				Storyboard.TargetProperty="Y"
				BeginTime="0:0:0">

				<SplineDoubleKeyFrame
					KeyTime="0:0:0"
					Value="0"/>

				<SplineDoubleKeyFrame
					KeyTime="0:0:0.75"
					Value="-42"/>

				<SplineDoubleKeyFrame
					KeyTime="0:0:1.5"
					Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="MovingFile1"
				Storyboard.TargetProperty="Opacity"
				BeginTime="0:0:0">

				<DiscreteDoubleKeyFrame
					KeyTime="0:0:0"
					Value="0"/>

				<LinearDoubleKeyFrame
					KeyTime="0:0:0.2"
					Value="1"/>

				<LinearDoubleKeyFrame
					KeyTime="0:0:1.25"
					Value="1"/>

				<LinearDoubleKeyFrame
					KeyTime="0:0:1.5"
					Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<!-- FILE 2 -->
			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File2Transform"
				Storyboard.TargetProperty="X"
				BeginTime="0:0:0.65">

				<SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="155"/>
				<SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="315"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File2Transform"
				Storyboard.TargetProperty="Y"
				BeginTime="0:0:0.65">

				<SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-55"/>
				<SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="MovingFile2"
				Storyboard.TargetProperty="Opacity"
				BeginTime="0:0:0.65">

				<DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
				<LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1"/>
				<LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<!-- FILE 3 -->
			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File3Transform"
				Storyboard.TargetProperty="X"
				BeginTime="0:0:1.3">

				<SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="155"/>
				<SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="315"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File3Transform"
				Storyboard.TargetProperty="Y"
				BeginTime="0:0:1.3">

				<SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-36"/>
				<SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="MovingFile3"
				Storyboard.TargetProperty="Opacity"
				BeginTime="0:0:1.3">

				<DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
				<LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1"/>
				<LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<!-- FILE 4 -->
			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File4Transform"
				Storyboard.TargetProperty="X"
				BeginTime="0:0:1.95">

				<SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="155"/>
				<SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="315"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="File4Transform"
				Storyboard.TargetProperty="Y"
				BeginTime="0:0:1.95">

				<SplineDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<SplineDoubleKeyFrame KeyTime="0:0:0.75" Value="-48"/>
				<SplineDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>

			</DoubleAnimationUsingKeyFrames>

			<DoubleAnimationUsingKeyFrames
				Storyboard.TargetName="MovingFile4"
				Storyboard.TargetProperty="Opacity"
				BeginTime="0:0:1.95">

				<DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
				<LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
				<LinearDoubleKeyFrame KeyTime="0:0:1.25" Value="1"/>
				<LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>

			</DoubleAnimationUsingKeyFrames>

		</Storyboard>


		<!-- Rounded ProgressBar -->
		<Style
			x:Key="SplashProgressBarStyle"
			TargetType="ProgressBar">

			<Setter Property="Height"
					Value="12"/>

			<Setter Property="Background"
					Value="#292D35"/>

			<Setter Property="Foreground"
					Value="#00A8D8"/>

			<Setter Property="BorderThickness"
					Value="0"/>

			<Setter Property="Template">

				<Setter.Value>

					<ControlTemplate TargetType="ProgressBar">

						<Grid>

							<Border
								Background="{TemplateBinding Background}"
								CornerRadius="6"/>

							<Grid
								x:Name="PART_Track">

								<Border
									x:Name="PART_Indicator"
									HorizontalAlignment="Left"
									CornerRadius="6"
									Background="{TemplateBinding Foreground}"/>

							</Grid>

						</Grid>

					</ControlTemplate>

				</Setter.Value>

			</Setter>

		</Style>

	</Window.Resources>

	<Border
		Background="#17191F"
		BorderBrush="#2C3038"
		BorderThickness="1"
		CornerRadius="20"
		Padding="38">

		<Border.Effect>
			<DropShadowEffect
				BlurRadius="30"
				ShadowDepth="0"
				Opacity="0.45"/>
		</Border.Effect>

		<!-- Border may only contain ONE child -->
		<Grid>

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>


			<!-- App Icon -->
			<Border
				Grid.Row="0"
				Width="82"
				Height="82"
				Background="#252932"
				CornerRadius="20"
				HorizontalAlignment="Center">

				<Border.Effect>
					<DropShadowEffect
						BlurRadius="18"
						ShadowDepth="3"
						Opacity="0.25"/>
				</Border.Effect>

				<TextBlock
					Text="📁"
					FontSize="44"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"/>

			</Border>


			<!-- Branding -->
			<StackPanel
				Grid.Row="1"
				Margin="0,18,0,0"
				HorizontalAlignment="Center">

				<TextBlock
					Text="Folder Organizer"
					Foreground="#FFFFFF"
					FontSize="28"
					FontWeight="SemiBold"
					HorizontalAlignment="Center"/>

				<TextBlock
					Text="Scanning smarter. Moving safer."
					Foreground="#949AA5"
					FontSize="13"
					Margin="0,5,0,0"
					HorizontalAlignment="Center"/>

			</StackPanel>


			<!-- File Transfer Animation -->
			<Canvas
				x:Name="TransferCanvas"
				Grid.Row="2"
				Width="500"
				Height="130"
				Margin="0,18,0,6"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				ClipToBounds="False">

				<!-- Transfer path -->
				<Line
					Panel.ZIndex="0"
					X1="110"
					Y1="65"
					X2="390"
					Y2="65"
					Stroke="#3A4655"
					StrokeThickness="1"
					StrokeDashArray="4,5"
					Opacity="0.7"/>


				<!-- FILE 1 -->
				<svgc:SvgViewbox
					x:Name="MovingFile1"
					Panel.ZIndex="5"
					Canvas.Left="78"
					Canvas.Top="48"
					Width="34"
					Height="34"
					Opacity="0"
					Stretch="Uniform"
					Source="pack://application:,,,/Assets/file.svg">

					<svgc:SvgViewbox.RenderTransform>
						<TranslateTransform
							x:Name="File1Transform"/>
					</svgc:SvgViewbox.RenderTransform>

				</svgc:SvgViewbox>


				<!-- FILE 2 -->
				<svgc:SvgViewbox
					x:Name="MovingFile2"
					Panel.ZIndex="5"
					Canvas.Left="78"
					Canvas.Top="48"
					Width="34"
					Height="34"
					Opacity="0"
					Stretch="Uniform"
					Source="pack://application:,,,/Assets/image.svg">

					<svgc:SvgViewbox.RenderTransform>
						<TranslateTransform
							x:Name="File2Transform"/>
					</svgc:SvgViewbox.RenderTransform>

				</svgc:SvgViewbox>


				<!-- FILE 3 -->
				<svgc:SvgViewbox
					x:Name="MovingFile3"
					Panel.ZIndex="5"
					Canvas.Left="78"
					Canvas.Top="48"
					Width="34"
					Height="34"
					Opacity="0"
					Stretch="Uniform"
					Source="pack://application:,,,/Assets/music.svg">

					<svgc:SvgViewbox.RenderTransform>
						<TranslateTransform
							x:Name="File3Transform"/>
					</svgc:SvgViewbox.RenderTransform>

				</svgc:SvgViewbox>


				<!-- FILE 4 -->
				<svgc:SvgViewbox
					x:Name="MovingFile4"
					Panel.ZIndex="5"
					Canvas.Left="78"
					Canvas.Top="48"
					Width="34"
					Height="34"
					Opacity="0"
					Stretch="Uniform"
					Source="pack://application:,,,/Assets/zip.svg">

					<svgc:SvgViewbox.RenderTransform>
						<TranslateTransform
							x:Name="File4Transform"/>
					</svgc:SvgViewbox.RenderTransform>

				</svgc:SvgViewbox>


				<!-- Source Folder -->
				<svgc:SvgViewbox
					x:Name="SourceFolder"
					Panel.ZIndex="10"
					Canvas.Left="20"
					Canvas.Top="20"
					Width="100"
					Height="80"
					Stretch="Uniform"
					Source="pack://application:,,,/Assets/folder.svg"/>


				<!-- Destination Folder -->
				<svgc:SvgViewbox
					x:Name="DestinationFolder"
					Panel.ZIndex="10"
					Canvas.Left="380"
					Canvas.Top="20"
					Width="100"
					Height="80"
					Stretch="Uniform"
					Source="pack://application:,,,/Assets/folder.svg"/>

			</Canvas>


			<!-- Loading Area -->
			<Grid
				Grid.Row="3"
				Margin="12,20,12,0"
				VerticalAlignment="Center">

				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>


				<!-- Real startup status -->
				<Grid
					Grid.Row="0"
					Margin="0,0,0,9">

					<TextBlock
						x:Name="StatusText"
						Text="Starting Folder Organizer..."
						Foreground="#CDD1D8"
						FontSize="13"
						HorizontalAlignment="Left"/>

					<TextBlock
						x:Name="PercentageText"
						Text="0%"
						Foreground="#CDD1D8"
						FontSize="13"
						FontWeight="SemiBold"
						HorizontalAlignment="Right"/>

				</Grid>


				<!-- ONE progress bar -->
				<ProgressBar
					x:Name="StartupProgress"
					Grid.Row="1"
					Minimum="0"
					Maximum="100"
					Value="0"
					Style="{StaticResource SplashProgressBarStyle}"/>


				<!-- Rotating joke -->
				<TextBlock
					x:Name="QuipText"
					Grid.Row="2"
					Text="Pretending to do important computer things..."
					Foreground="#737A86"
					FontSize="11"
					FontStyle="Italic"
					TextAlignment="Center"
					HorizontalAlignment="Center"
					Margin="0,10,0,0"/>

			</Grid>


			<!-- Footer -->
			<TextBlock
				Grid.Row="4"
				Text="Folder Organizer  •  v1.0"
				Foreground="#5F6570"
				FontSize="10"
				HorizontalAlignment="Center"
				Margin="0,24,0,0"/>

		</Grid>

	</Border>
</Window>