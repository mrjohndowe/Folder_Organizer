<Window
    x:Class="FolderOrganizer.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Folder Organizer"
    Width="900"
    Height="500"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="#191D24">

    <Grid>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,55,0,0">

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="42"
                FontWeight="Bold">

                <Run
                    Text="Folder "
                    Foreground="#F5F7FA"/>

                <Run
                    Text="Organizer"
                    Foreground="#00A8D8"/>

            </TextBlock>

            <TextBlock
                Text="Organizing your files"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                FontSize="15"
                Foreground="#BEC8D4"/>

        </StackPanel>

        <Canvas
            x:Name="AnimationCanvas"
            Width="700"
            Height="220"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,35,0,0"/>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,45">

            <Border
                Width="300"
                Height="6"
                Background="#2F3743"
                CornerRadius="3">

                <Border
                    x:Name="ProgressFill"
                    Width="0"
                    Height="6"
                    Background="#00A8D8"
                    CornerRadius="3"
                    HorizontalAlignment="Left"/>

            </Border>

            <TextBlock
                x:Name="StatusText"
                Text="Starting..."
                HorizontalAlignment="Center"
                Margin="0,12,0,0"
                FontSize="13"
                Foreground="#BEC8D4"/>

        </StackPanel>

    </Grid>

</Window>