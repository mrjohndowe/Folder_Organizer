<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Folder Organizer"
      Manufacturer="Folder Organizer"
      Version="$(var.MyAppVersion)"
      UpgradeCode="2E265690-20FE-4597-8D1D-59B1EA28A0D1"
      Scope="perMachine">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of Folder Organizer is already installed." />

    <MediaTemplate
        EmbedCab="yes"
        CompressionLevel="high" />

    <!-- ARP metadata -->
    <Property
        Id="ARPCOMMENTS"
        Value="Organize files and folders safely with preview and history." />

    <WixVariable
        Id="WixUILicenseRtf"
        Value="$(var.InstallerSourceDir)\TermsOfService.rtf" />

    <ui:WixUI
        Id="WixUI_InstallDir"
        InstallDirectory="INSTALLFOLDER" />

    <Property
        Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
        Value="Launch Folder Organizer" />

    <!-- Installation directory -->
    <StandardDirectory Id="ProgramFiles64Folder">

      <Directory
          Id="INSTALLFOLDER"
          Name="Folder Organizer">

        <Component Id="FolderOrganizerMainComponent">

          <File
              Id="FolderOrganizerExe"
              Source="$(var.PublishDir)\FolderOrganizer.exe"
              KeyPath="yes" />

        </Component>

        <Component Id="TermsOfServiceComponent">

          <File
              Id="TermsOfServiceText"
              Source="$(var.InstallerSourceDir)\TermsOfService.txt"
              KeyPath="yes" />

        </Component>

        <Component Id="ReadmeComponent">

          <File
              Id="ReadmeText"
              Source="$(var.InstallerSourceDir)\README.txt"
              KeyPath="yes" />

        </Component>

       <Files Include="$(var.PublishDir)\**">
          <Exclude Files="$(var.PublishDir)\FolderOrganizer.exe" />
      </Files>

      </Directory>

    </StandardDirectory>

    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">

      <Directory
          Id="ApplicationProgramsFolder"
          Name="Folder Organizer">

        <Component Id="StartMenuShortcutComponent">

          <Shortcut
              Id="StartMenuShortcut"
              Name="Folder Organizer"
              Description="Folder Organizer"
              Target="[INSTALLFOLDER]FolderOrganizer.exe"
              WorkingDirectory="INSTALLFOLDER" />

          <RemoveFolder
              Id="RemoveApplicationProgramsFolder"
              On="uninstall" />

          <RegistryValue
              Root="HKCU"
              Key="Software\FolderOrganizer"
              Name="StartMenuShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />

        </Component>

      </Directory>

    </StandardDirectory>

    <!-- Launch app after interactive install only -->
    <CustomAction
        Id="LaunchFolderOrganizer"
        FileRef="FolderOrganizerExe"
        ExeCommand=""
        Execute="immediate"
        Return="asyncNoWait"
        Impersonate="yes" />

    <InstallExecuteSequence>
    </InstallExecuteSequence>

    <UI>
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="LaunchFolderOrganizer"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

  </Package>

</Wix>
